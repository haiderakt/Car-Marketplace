# Replace this value with a unique secret before running the API.
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Used when running the API directly on your machine.
# Docker Compose sets DATABASE_URL for the API container automatically.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/car_marketplace
